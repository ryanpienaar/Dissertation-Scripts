get_season <- function(date) {
  month <- month(date)
  if (month %in% c(11, 12, 1, 2)) {
    return("Winter")
  } else if (month %in% c(3, 4)) {
    return("Spring")
  } else if (month %in% c(5, 6, 7, 8)) {
    return("Summer")
  } else if (month %in% c(9, 10)) {
    return("Fall")
  }
}

# Try again but with how Roerick et al. defined seasons
get_season <- function(date) {
  month <- month(date)
  if (month %in% c(12, 1, 2)) {
    return("Winter")
  } else if (month %in% c(3, 4)) {
    return("Spring")
  } else if (month %in% c(5, 6, 7, 8, 9)) {
    return("Summer")
  } else if (month %in% c(11, 10)) {
    return("Fall")
  }
}

