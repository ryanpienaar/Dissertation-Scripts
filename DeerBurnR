```{r}

# make named list (don't worry about the warning)
Year_frame <- list(
   Year = matrix(
     dh$Year,
     ncol = dim(deer_y)[2],
     nrow = dim(deer_y)[1]
   ),
   Forest = deer_covariates$Forest,
   Fire = deer_covariates$Fire,
   Season = matrix(seasons,
                   ncol = dim(deer_y)[2],
     nrow = dim(deer_y)[1])
                   
 )

deer_y
# modeling with no covariates
pnull <- auto_occ(
  formula = ~1  # detection
            ~1, # occupancy
  y = deer_y
)


p1 <- auto_occ(
      ~ Forest
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p2 <- auto_occ(
      ~ Fire
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p3 <- auto_occ(
      ~ Year
      ~1,
      y= deer_y,
      det_covs = Year_frame
)


p4 <- auto_occ(
      ~ Forest + Fire
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p5 <- auto_occ(
      ~ Forest * Fire
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p6 <- auto_occ(
      ~ Forest + Year
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p7 <- auto_occ(
      ~ Forest * Year
      ~1,
      y= deer_y,
      det_covs = Year_frame
)

p8 <- auto_occ(
      ~ Fire + Year
      ~1,
      y= deer_y,
      det_covs = Year_frame
)


p9 <- auto_occ(
      ~ Fire * Year
      ~1,
      y= deer_y,
      det_covs = Year_frame
)


detection.aic <- compare_models(
  list(null = pnull,
       Forest = p1,
       Fire = p2,
       Year = p3,
       `Forest+Fire` = p4,
       `Forest*Fire` = p5,
       `Forest+Year` = p6,
       `Forest*Year` =p7,
       `Fire+Year` = p8,
       `Fire*Year` = p9),
  digits = 2
)

summary(p7)

dfd.table <- detection.aic
dfd.table
